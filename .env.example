# ── LLM (cloud brain) ────────────────────────────────────────────────────────
# LLM_PROVIDER: openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Transmission (local torrent daemon on the Pi) ────────────────────────────
TRANSMISSION_URL=http://localhost:9091
TRANSMISSION_USER=
TRANSMISSION_PASS=

# ── Samsung washer (SmartThings) ─────────────────────────────────────────────
SMARTTHINGS_PAT=
WASHER_DEVICE_ID=b6d6a88b-8f08-919d-e51d-7f4799882d38

# ── Haier fridge (hOn cloud — unofficial, fragile) ───────────────────────────
# The hOn account must be email+password. If yours is Google-linked, run the
# hOn app's password-reset flow for that Gmail first (or create a normal
# account and invite it to the family group).
HON_USER=
HON_PASS=

# ── Torrent search (Prowlarr) ────────────────────────────────────────────────
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# ── Systemair SaveConnect 2.0 ventilation (local REST API) ───────────────────
# e.g. http://192.168.8.xxx  (find the gateway IP in your router's DHCP table)
SAVECONNECT_URL=

# ── Open Food Facts (inventory) ──────────────────────────────────────────────
OFF_USER_AGENT=HomeVoiceAssistant/0.1 (personal home project)

# ── Optional: server-side STT via Groq (browser Web Speech API is the default) ─
GROQ_API_KEY=

# ── Email receipts (IMAP — auto-import Coop PDFs from your inbox) ────────────
# Gmail: EMAIL_HOST=imap.gmail.com, EMAIL_PASS = an App Password (not your login)
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=
EMAIL_PASS=
EMAIL_FOLDER=INBOX

# ── Local filesystem access (hard drive) ────────────────────────────────────
# Root folder the assistant may browse/read (default: your home directory).
FS_ROOT=
FILE_READ_LIMIT=100000

# ── Weather (Open-Meteo, free — no key) ────────────────────────────────────
WEATHER_LAT=58.378
WEATHER_LON=26.729

# ── Kodi (JSON-RPC on the Pi, default web port 8080) ────────────────────────
KODI_URL=http://192.168.8.137:8080
KODI_USER=
KODI_PASS=

# ── Jellyfin (self-hosted media server) ─────────────────────────────────────
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# ── OpenSubtitles.com (auto-download subtitles for movies without .srt) ──────
# API key from https://www.opensubtitles.com/en/consumers (Create a new consumer)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER=daum13
OPENSUBTITLES_PASS=

# ── General ──────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=10
LLM_TIMEOUT=60
DB_PATH=data/home.db
